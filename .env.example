# Copy to .env and edit. All values have dev-friendly defaults except JWT_SECRET,
# which the server refuses to guess when NODE_ENV=production.

PORT=3000
NODE_ENV=development

# HS256 signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECONDS=86400

# SQLite file. ":memory:" gives a throwaway DB (used by the test suite).
DATABASE_PATH=./data/chat.sqlite

# Bootstrap admin. Created on first boot only if the username is not taken.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Message rate limit: token bucket per user.
RATE_LIMIT_BURST=5
RATE_LIMIT_REFILL_PER_SEC=1

# Max ops/sec per connection across *all* frame types (cheap flood guard).
CONNECTION_OPS_BURST=30
CONNECTION_OPS_REFILL_PER_SEC=10
