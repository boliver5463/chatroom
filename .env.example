# Copy to .env and edit. All values have dev-friendly defaults except JWT_SECRET,
# which the server refuses to guess when NODE_ENV=production.

PORT=3000
NODE_ENV=development

# HS256 signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me
JWT_TTL_SECONDS=86400

# SQLite file. ":memory:" gives a throwaway DB (used by the test suite).
DATABASE_PATH=./data/chat.sqlite

# Bootstrap admin. Created on first boot only if the username is not taken.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Message rate limit: token bucket per user.
RATE_LIMIT_BURST=3
RATE_LIMIT_REFILL_PER_SEC=3

# Max ops/sec per connection across *all* frame types (cheap flood guard).
CONNECTION_OPS_BURST=30
CONNECTION_OPS_REFILL_PER_SEC=10

# Giphy. Leave GIPHY_API_KEY empty to disable GIFs entirely: the search
# endpoints 404 and the client hides its GIF button. Get a key at
# https://developers.giphy.com/. It is only ever used server-side — the browser
# talks to /api/giphy/*, never to Giphy directly.
GIPHY_API_KEY=
# Content rating ceiling: g, pg, pg-13, or r.
GIPHY_RATING=pg-13
GIPHY_RESULT_LIMIT=24
GIPHY_TIMEOUT_MS=6000

# GIF search budget, per user (each search is an upstream API call).
GIPHY_RATE_LIMIT_BURST=15
GIPHY_RATE_LIMIT_REFILL_PER_SEC=1
